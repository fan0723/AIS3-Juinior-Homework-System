# AAMS Docker 測試環境設定（複製成 .env 後填寫；.env 不會進版控）
# 產生隨機值：python -c "import secrets;print(secrets.token_urlsafe(48))"
AAMS_SECRET_KEY=
POSTGRES_PASSWORD=
# 瀏覽器輸入的主機名稱：單機測試用 localhost；給其他電腦連時改成本機的區網 IP（例如 192.168.1.50）
AAMS_DOMAIN=localhost
# Caddy 綁定的 IP：單機測試用 127.0.0.1；給其他電腦連時改成同一個區網 IP
AAMS_BIND_IP=127.0.0.1
AAMS_EVENT_NAME=AIS3 Junior 2026 測試
AAMS_EVENT_END_AT=
AAMS_SYSTEM_ALLOWED_TYPES=pdf,png,jpg,txt
# 測試環境不連 Discord（留空 = 不傳送）
AAMS_DISCORD_STAFF_WEBHOOK=
AAMS_DISCORD_STUDENT_WEBHOOK=
AAMS_REMINDER_HOURS=
