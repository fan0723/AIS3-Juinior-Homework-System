# docker compose 用設定（複製為 .env.docker 後填寫，勿提交版控）
# 產生隨機值：python -c "import secrets;print(secrets.token_urlsafe(48))"
AAMS_SECRET_KEY=
POSTGRES_PASSWORD=
# 使用者在瀏覽器輸入的主機名稱（需能在 VPN 內解析，例如 aams.ais3.lan）
AAMS_DOMAIN=aams.ais3.lan
# WireGuard 介面上的伺服器 IP
AAMS_BIND_IP=10.66.0.1
AAMS_EVENT_NAME=AIS3 Junior 2026
# 營隊結束日（台北時間）。作業「最終收件期限」預設 = 此日 + 7 天
AAMS_EVENT_END_AT=2026-08-20
# Discord Webhook（staff = 警示與成績申覆；student = 公告與成績發布）與截止提醒預設（小時）：
# 建議留空，由管理員在網頁「管理後台 › 系統」設定（加密存放）。這裡填了就以 .env 為準，網頁上鎖住不能改。
AAMS_DISCORD_STAFF_WEBHOOK=
AAMS_DISCORD_STUDENT_WEBHOOK=
AAMS_REMINDER_HOURS=
AAMS_SYSTEM_ALLOWED_TYPES=pdf,png,jpg,txt
